{
  "expo": {
    "name": "FundWise",
    "slug": "fundwise-seeker",
    "scheme": "fundwiseseeker",
    "version": "0.1.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "fun.fundwise.seeker",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FBFCF9"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "fundwise.fun",
              "pathPrefix": "/groups"
            },
            {
              "scheme": "https",
              "host": "fundwise.fun",
              "pathPrefix": "/join"
            },
            {
              "scheme": "https",
              "host": "fundwise.fun",
              "pathPrefix": "/settle/r"
            },
            {
              "scheme": "https",
              "host": "fundwise.fun",
              "pathPrefix": "/receipts"
            },
            {
              "scheme": "https",
              "host": "beta.fundwise.fun",
              "pathPrefix": "/groups"
            },
            {
              "scheme": "https",
              "host": "beta.fundwise.fun",
              "pathPrefix": "/join"
            },
            {
              "scheme": "https",
              "host": "beta.fundwise.fun",
              "pathPrefix": "/settle/r"
            },
            {
              "scheme": "https",
              "host": "beta.fundwise.fun",
              "pathPrefix": "/receipts"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "./plugins/withWalletQueries",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-font"
    ],
    "extra": {
      "fundwiseUrl": "https://fundwise.fun",
      "eas": {
        "projectId": "e8b27a7f-9a8c-4a87-ab2e-94cf258c86c9"
      }
    },
    "owner": "sarthiii"
  }
}
