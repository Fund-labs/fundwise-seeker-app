{
  "expo": {
    "name": "FundWise",
    "slug": "fundwise-seeker",
    "scheme": "fundwiseseeker",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "fun.fundwise.seeker",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FBFCF9"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "fundwise.fun",
              "pathPrefix": "/groups"
            },
            {
              "scheme": "https",
              "host": "fundwise.fun",
              "pathPrefix": "/join"
            },
            {
              "scheme": "https",
              "host": "fundwise.fun",
              "pathPrefix": "/settle/r"
            },
            {
              "scheme": "https",
              "host": "fundwise.fun",
              "pathPrefix": "/receipts"
            },
            {
              "scheme": "https",
              "host": "beta.fundwise.fun",
              "pathPrefix": "/groups"
            },
            {
              "scheme": "https",
              "host": "beta.fundwise.fun",
              "pathPrefix": "/join"
            },
            {
              "scheme": "https",
              "host": "beta.fundwise.fun",
              "pathPrefix": "/settle/r"
            },
            {
              "scheme": "https",
              "host": "beta.fundwise.fun",
              "pathPrefix": "/receipts"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "./plugins/withWalletQueries",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "extra": {
      "fundwiseUrl": "https://fundwise.fun"
    }
  }
}
